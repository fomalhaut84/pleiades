# pleiades 루트 .env 템플릿 — 플랫폼 키만 (#143 · M-6a-2). 복사: cp .env.example .env (루트 .env 는 gitignore)
# 두 앱이 @pleiades/notify platformEnv 로 이 파일의 NOTIFY_* · DISCORD_WEBHOOK_* · DISCORD_BOT_TOKEN_* · DISCORD_CHANNEL_ID_* ·
# DISCORD_ALLOWED_USER_IDS 만 직접 읽는다(실행 방식 무관) —
# 그 밖의 키는 읽지 않는다. 이 키들은 앱 .env 에 두지 않는다(check_env 가 막는다). 경로 지정: PLEIADES_ENV_FILE.
# 앱 고유 설정(DB · 텔레그램 봇 토큰 · 텔레그램 수신 chat · 외부 계정)은 apps/<app>/.env 에 둔다.
# 비워 두면 알림은 텔레그램(지금과 같다). 웹훅 URL · Discord 봇 토큰은 검증 Discord 서버 것만 — 비밀이다.
# 주석은 줄 위에 단다(값 뒤 `# …` 는 잘라내지만 헷갈리지 않게).

# 라우트별 채널 — "discord" 면 Discord, 그 외·미설정이면 텔레그램. 두 앱 공통(앱마다 채널은 다르다).
NOTIFY_ALLOWED_CHANNEL=""
# fin 관리자 알림 (fit 은 ADMIN 미매핑)
NOTIFY_ADMIN_CHANNEL=""

# 앱별 채널 웹훅 — 앱이 늘면 DISCORD_WEBHOOK_<APP> 한 줄을 더한다
DISCORD_WEBHOOK_FINANCE=""
DISCORD_WEBHOOK_FITNESS=""
DISCORD_WEBHOOK_ADMIN=""

# 버튼(인터랙션) 메시지 — M-6b(#149 · #151). "discord" 면 키보드 메시지를 앱별 Discord 봇이 보내고 그 봇 프로세스의
# gateway 가 클릭을 받는다. 텍스트 스위치와 따로 켜고 끈다. 봇 토큰·채널이 있으면 gateway 는 스위치와 무관하게 접속한다.
# 연결된 버튼: fit 자동조정(#151) · fin RSU 베스팅 확정·취소(#155)
NOTIFY_INTERACTIVE_CHANNEL=""
# 앱별 비공개 봇 토큰 (Developer Portal · Installation 링크 None → Public Bot 끄기)
DISCORD_BOT_TOKEN_FINANCE=""
DISCORD_BOT_TOKEN_FITNESS=""
# 앱별 채널 ID (개발자 모드 → 채널 우클릭 → ID 복사)
DISCORD_CHANNEL_ID_FINANCE=""
DISCORD_CHANNEL_ID_FITNESS=""
# 버튼을 누를 수 있는 사용자 ID (쉼표 구분) — 비면 모든 클릭을 거부한다(허용 = 사용자 AND 채널)
DISCORD_ALLOWED_USER_IDS=""
