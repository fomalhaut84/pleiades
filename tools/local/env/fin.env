# pleiades 로컬 fin env 템플릿 (#118 · 006 §4-5 L-2) — tools/local/write_env.py fin 이 apps/finance/.env 로 쓴다.
# 복사 금지 3종(원본 .env · repos/*/.env · .env.example) 대신 이 파일. __X__ 는 write_env 가 채운다.
DATABASE_URL="postgresql://__PGUSER__@localhost:5432/pleiades_fin"
BASE_URL="http://localhost:4610"
PORT=4610
MCP_PORT=4611

AUTH_SECRET="__SECRET__"
AUTH_PIN="__PIN__"
AUTH_TRUST_HOST="true"

# 검증 봇 토큰 준비 전에는 비운다 (L-4 · I-4) — 서비스 봇 토큰을 넣지 않는다
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""
TELEGRAM_ADMIN_CHAT_IDS=""
TELEGRAM_WEBHOOK_SECRET="__SECRET__"

# 실제 가계부에 기록된다 — 비운다 (L-6)
WHOOING_WEBHOOK_URL=""
