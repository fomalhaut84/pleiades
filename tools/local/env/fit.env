# pleiades 로컬 fit env 템플릿 (#118 · 006 §4-5 L-2) — tools/local/write_env.py fit 이 apps/fitness/.env 로 쓴다.
# 복사 금지 3종(원본 .env · repos/*/.env · .env.example) 대신 이 파일. __X__ 는 write_env 가 채운다.
# M-2 에서는 pleiades_fit 을 만들지 않는다 — prisma generate · build 는 DB 없이 통과한다(006 §4-3).
DATABASE_URL="postgresql://__PGUSER__@localhost:5432/pleiades_fit"
BASE_URL="http://localhost:4620"
PORT=4620
MCP_PORT=4621

# 서비스 Garmin 세션 · 외부 API — 비운다 (L-5 · L-6). 웹 기동 시 싱크 cron 에러 로그는 수용한다
GARMIN_EMAIL=""
GARMIN_PASSWORD=""
MFDS_API_KEY=""

# 검증 봇 토큰 준비 전에는 비운다 (L-4 · I-4)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# 비우면 PATH 로 풀린다 — 비어 있지 않은 없는 절대 경로 (L-7)
CLAUDE_BIN="/nonexistent/claude-disabled"
