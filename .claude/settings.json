{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/isolation_guard.py"
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "**/apps/*/CLAUDE.md",
    "**/apps/*/.claude/**"
  ]
}
