#!/bin/sh
# claude shim — 로컬에서 띄운 apps/* 의 advisor 가 실제 claude 를 부르지 못하게 막는다 (#104 · 006 L-7 · I-8).
# fin 은 'claude' 를 하드코딩하고 sh -c 로 부른다 → tools/local/run.sh 가 이 디렉터리를 PATH 맨 앞에 둔다.
# pleiades 세션의 claude 와 무관하다 — PATH 에 bin/ 을 넣는 것은 run.sh 뿐이다.
echo "claude: pleiades 로컬 shim — advisor 차단 (006 L-7). 실제 claude 를 부르지 않는다" >&2
exit 1
