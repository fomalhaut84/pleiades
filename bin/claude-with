#!/usr/bin/env bash
# claude-with — pleiades 세션에 대상 저장소 하네스를 한 개만 붙여 Claude Code 를 연다.
# 근거: docs/specs/005-harness-integration.md §4-5·§4-6 ④ (Q30, 사용자 확정 2026-09-07)
#
# 사용:  bin/claude-with <fin|fit> [claude 인자...]
#   fin → ~/workspace/myFinance (원본, dev)     fit → ~/workspace/myFitness (원본, main)
#
# 왜 래퍼인가 (measured-facts "--add-dir 로딩 범위와 환경변수", Q37):
#   - permissions.additionalDirectories(settings) 는 툴 권한만 영속화한다. skills·agents·rules 는 --add-dir 로만 로드된다.
#   - 환경변수 CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 이 없으면 skills·agents 만 보이고
#     rules·CLAUDE.md 는 조용히 빠진다 — 규범 없이 스킬만 도는 가장 나쁜 상태. 래퍼는 이것을 항상 켠다.
#   - 대상은 항상 원본이다. fit .claude/ 는 worktree 에 없고, repos/*/.claude 는 중첩이라 로드되지 않는다.
#   - 한 번에 한 저장소만: 둘 다 붙이면 rule 은 7벌 공존, agent `release-manager` 는 마지막 디렉터리가 조용히 이긴다.
#   - --add-dir 는 --resume 시 복원되지 않는다. 재개할 때도 이 래퍼로 연다.
#   - cwd 가 pleiades 가 아니면 중단한다 — pleiades 하네스 없이 대상 저장소만 붙으면 승인 게이트가 사라진다.
set -euo pipefail

usage() { sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

[[ $# -ge 1 ]] || usage 1
case "$1" in
  fin) target="$HOME/workspace/myFinance" ;;
  fit) target="$HOME/workspace/myFitness" ;;
  -h|--help) usage 0 ;;
  *) echo "claude-with: 첫 인자는 fin 또는 fit 이어야 한다 (받은 값: '$1')" >&2; usage 1 ;;
esac
shift

for a in "$@"; do
  if [[ "$a" == "--add-dir" ]]; then
    echo "claude-with: --add-dir 를 추가로 넘기지 않는다 — 한 번에 한 저장소만 붙인다 (005 §4-5)" >&2; exit 1
  fi
done

[[ -d "$target/.claude" ]] || { echo "claude-with: $target/.claude 가 없다" >&2; exit 1; }
[[ "$(pwd)" == "$HOME/workspace/pleiades" ]] || {
  echo "claude-with: cwd 가 pleiades 가 아니다 ($(pwd)). pleiades 하네스(dual-repo-change 승인 게이트 등)가 로드되지 않으므로 중단한다 — cd ~/workspace/pleiades 후 다시 실행" >&2; exit 1; }

cat >&2 <<MSG
claude-with: $target 을 --add-dir 로 붙인다 (CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1).
  · rule 은 두 벌이 공존한다 — pleiades workflow.md 7절 표(base integration/pleiades)와 이 저장소의 feat/*→dev 가 같은 세션에서 규범이 된다.
  · 이 세션에서 그 저장소에 쓰는 작업은 dual-repo-change 승인 게이트를 거친다.
MSG

# 넘겨받은 인자를 --add-dir 앞에 둔다 — --add-dir 는 variadic 이라 뒤에 오는 위치 인자(프롬프트)를 디렉터리로 먹는다 (measured-facts Q37)
exec env CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 claude "$@" --add-dir "$target"
