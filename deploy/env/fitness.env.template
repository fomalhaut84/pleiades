# 서버 apps/fitness/.env 키 목록 — 값 없음 (007 T-1b · #176). 출처: _workspace/007/01_surveyor_cutover.md §3 + apps/fitness/.env.example + 코드 process.env 재측정(2026-10-20).
# [T-5c] = 서비스 실값. T-4 체크아웃에는 넣지 않고 T-5c ① 에서 처음 넣는다(007 정정 6 · §6 I-4·I-5·I-6·I-7·I-8).
# 플랫폼 키(NOTIFY_* · DISCORD_*)는 여기 두지 않는다 — 루트 .env 한 곳(PLEIADES_ENV_FILE · .env.example). 앱 .env 에 두면 루트 값을 가린다(#143).

# DB [T-5c] — 기존 서비스 DB 그대로(007 DB-a)
DATABASE_URL=

# 포트 — deploy/pleiades.config.cjs 가 둘 다 요구한다
PORT=
MCP_PORT=
# BASE_URL=          (템플릿에만 있고 코드가 읽지 않는다)
# APP_BASE_URL=      (선택 · 비우면 pm2 설정이 http://localhost:$PORT 로 MCP 에 준다)

# 텔레그램 [T-5c]
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# 외부 계정 [T-5c] — 토큰 디렉터리 .garmin-tokens/ · .omron-tokens/ 는 P-2 심링크(007 4-2)
GARMIN_EMAIL=
GARMIN_PASSWORD=
OMRON_EMAIL=
OMRON_PASSWORD=
OMRON_APP_ID=
OMRON_APP_KEY=
OMRON_API_BASE=
MFDS_API_KEY=
# MFDS_BASE_URL=     (선택)

# 선택 키는 주석으로 둔다 — 값을 넣을 때만 주석을 푼다. 빈 값(`KEY=`)은 코드 기본값이 아니라 빈 문자열이다:
# 코드가 `process.env.X ?? 기본값` 이라 '' 가 그대로 쓰인다(예: fit 크론 '' → node-cron 오류 · MCP_TRANSPORT '' → stdio 판정 깨짐 · #178).

# 크론 — 선택 · 시각 전수는 measured-facts *2026-10-20 — 크론 전수(M1)*
# SYNC_CRON=
# REPORT_CRON=
# MORNING_REPORT_CRON=
# EVENING_REPORT_CRON=
# AUTO_ADJUST_CRON=
# AUTO_ADJUST_MAINTENANCE_CRON=

# advisor · MCP — 선택
# CLAUDE_BIN=
# MCP_HTTP_URL=
# MCP_TRANSPORT=      (pm2 설정이 mcp 프로세스에 http 를 준다)
