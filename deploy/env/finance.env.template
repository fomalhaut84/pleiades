# 서버 apps/finance/.env 키 목록 — 값 없음 (007 T-1b · #176). 출처: _workspace/007/01_surveyor_cutover.md §3 + apps/finance/.env.example + 코드 process.env 재측정(2026-10-20).
# [T-5c] = 서비스 실값. T-4 체크아웃에는 넣지 않고 T-5c ① 에서 처음 넣는다(007 정정 6 · §6 I-4·I-5·I-7·I-8).
# 플랫폼 키(NOTIFY_* · DISCORD_*)는 여기 두지 않는다 — 루트 .env 한 곳(PLEIADES_ENV_FILE · .env.example). 앱 .env 에 두면 루트 값을 가린다(#143).

# DB [T-5c] — 기존 서비스 DB 그대로(007 DB-a)
DATABASE_URL=

# 포트 — deploy/pleiades.config.cjs 가 둘 다 요구한다. MCP_PORT 는 src/lib/ai/mcp-config.json 의 url 포트와 같아야 한다(deploy.sh 가 대조)
PORT=
MCP_PORT=
# BASE_URL=          (템플릿에만 있고 코드가 읽지 않는다)

# 웹 인증 [T-5c]
AUTH_SECRET=
AUTH_PIN=
AUTH_TRUST_HOST=

# 텔레그램 [T-5c]
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_POLLING=   (선택 · 정확히 off 면 폴링만 끈다 — 토큰·아웃바운드 텔레그램은 그대로 · 009 D-1 · 루트 .env 에 두면 읽히지 않는다)

# 외부 계정 [T-5c]
WHOOING_WEBHOOK_URL=

